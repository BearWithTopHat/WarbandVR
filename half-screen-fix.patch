+void StereoRenderer::ApplyEyeMono(IDirect3DDevice9* device, int eye)
+{
+    // Same target/viewport routing as ApplyEye, but no view/projection
+    // override: the element is 2D or a fullscreen composite quad and must be
+    // pixel-identical in both eyes.
+    D3DVIEWPORT9 vp;
+    if (m_hasGameVp)
+    {
+        vp = m_gameVp;
+    }
+    else
+    {
+        if (m_stereoW == 0) return;
+        vp.X = 0; vp.Y = 0;
+        vp.Width  = m_stereoW / 2;
+        vp.Height = m_stereoH;
+        vp.MinZ = 0.0f; vp.MaxZ = 1.0f;
+    }
+
+    if (m_shadowActive)
+    {
+        device->SetRenderTarget(0, m_shadowActive->eyeSurf[eye]);
+        if (m_shadowActive->depth)
+            device->SetDepthStencilSurface(m_shadowActive->depth);
+    }
+    else
+    {
+        vp.X = (eye == 0) ? 0 : vp.Width;
+    }
+    device->SetViewport(&vp);
+
+    if (m_scissorEnabled && m_hasScissor)
+    {
+        RECT r = m_gameScissor;
+        const LONG off = ActiveEyeOffset();
+        if (eye == 1) { r.left += off; r.right += off; }
+        device->SetScissorRect(&r);
+    }
+
+    for (const auto& bind : m_shadowBinds)
+        device->SetTexture(bind.first, bind.second->eyeTex[eye]);
+}
