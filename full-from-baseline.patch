@@ -0,0 +1,71 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+# WarbandVR headless test suite: unit + integration + parity.
+# Usage: sh tests/run_all.sh   (from the repo root)
+set -e
+cd "$(dirname "$0")/.."
+
+echo "== unit tests (pure logic)"
+g++ -std=c++17 -Wall -Wextra -Werror -Isrc tests/test_main.cpp -o tests/run_tests
+./tests/run_tests
+
+echo "== integration tests (fake device, real hooks + renderer)"
+g++ -std=c++17 -Wall -Wextra -Werror -Itests/winshim -Itests -Isrc \
+    tests/test_integration.cpp tests/fake_device.cpp tests/winshim_impl.cpp \
+    src/Logger.cpp src/Config.cpp src/Capture.cpp src/CameraScan.cpp \
+    src/StereoRenderer.cpp src/DeviceHooks.cpp src/OpenXRBridge.cpp src/MouseMap.cpp \
+    -o tests/run_integration
+./tests/run_integration
+
+echo "== reset/robustness fuzzing (random calls + injected HRESULT failures)"
+g++ -std=c++17 -Wall -Wextra -Werror -Itests/winshim -Itests -Isrc \
+    tests/test_fuzz.cpp tests/fake_device.cpp tests/winshim_impl.cpp \
+    src/Logger.cpp src/Config.cpp src/Capture.cpp src/CameraScan.cpp \
+    src/StereoRenderer.cpp src/DeviceHooks.cpp src/OpenXRBridge.cpp src/MouseMap.cpp \
+    -o tests/run_fuzz
+./tests/run_fuzz
+
+echo "== motion-input tests (fake OpenXR actions + recording input sink)"
+g++ -std=c++17 -Wall -Wextra -Werror -DWBVR_WITH_OPENXR \
+    -Itests/winshim -Itests/xr_fake -Itests -Isrc \
+    tests/test_motion_input.cpp tests/xr_fake.cpp tests/winshim_impl.cpp \
+    src/Config.cpp src/Logger.cpp src/MotionInput.cpp \
+    -o tests/run_motion_input
+./tests/run_motion_input
+
+echo "== host compile gates (remaining proxy/entry TUs)"
+mkdir -p tests/obj
+for f in src/D3D9Proxy.cpp src/D3D9ExProxy.cpp src/DeviceProxy.cpp; do
+    g++ -std=c++17 -Wall -Wextra -Werror -Itests/winshim -Isrc \
+        -c "$f" -o "tests/obj/$(basename "$f" .cpp).o"
+done
+g++ -std=c++17 -Wall -Wextra -Werror -DWBVR_SHIM_NO_EXPORT_DECLS \
+    -Itests/winshim -Isrc -c src/dllmain.cpp -o tests/obj/dllmain.o
+
+echo "== zig cross-compile gates (stub + OpenXR, x86 Windows, warnings fatal)"
+python3 -m ziglang version >/dev/null
+mkdir -p tests/obj/zig-stub tests/obj/zig-openxr
+for f in src/*.cpp; do
+    o="tests/obj/zig-stub/$(basename "$f" .cpp).o"
+    python3 -m ziglang c++ -target x86-windows-gnu -c -std=c++17 \
+        -Wall -Wextra -Werror -Isrc "$f" -o "$o"
+done
+for f in src/*.cpp; do
+    o="tests/obj/zig-openxr/$(basename "$f" .cpp).o"
+    python3 -m ziglang c++ -target x86-windows-gnu -c -std=c++17 \
+        -DWBVR_WITH_OPENXR -Wall -Wextra -Werror \
+        -Isrc -Itests/xr_fake "$f" -o "$o"
+done
+
+echo "== companion module-system source checks"
+python3 tools/check_companion.py
+
+echo "== license audit"
+python3 tools/check_license.py
+python3 tools/check_workflow.py
+python3 -m py_compile tools/check_license.py tools/check_workflow.py tools/package_release.py
+
+echo "== parity gates"
+python3 tools/check_parity.py
+
+echo "ALL GREEN"
diff --git a/tests/test_fuzz.cpp b/tests/test_fuzz.cpp
new file mode 100644
index 0000000..9b5847d
--- /dev/null
+++ b/tests/test_fuzz.cpp
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Deterministic reset/robustness fuzzing over the real hooks and renderer.
+// The fake device injects HRESULT failures; assertions cover lifecycle
+// invariants rather than requiring any particular call sequence.
+
+#include "windows.h"
+#include "d3d9.h"
+#include "fake_device.h"
+#include "Config.h"
+#include "StereoRenderer.h"
+#include "DeviceHooks.h"
+
+#include <cstdio>
+#include <cstdint>
+
+static int g_failures = 0, g_checks = 0;
+#define CHECK(cond) do { ++g_checks; if (!(cond)) { \
+    ++g_failures; printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); } } while (0)
+
+namespace
+{
+    struct Rng
+    {
+        uint32_t s = 0x5EED1234u;
+        uint32_t Next()
+        {
+            s ^= s << 13; s ^= s >> 17; s ^= s << 5;
+            return s;
+        }
+        uint32_t Below(uint32_t n) { return n ? Next() % n : 0; }
+    };
+
+    D3DMATRIX Matrix(float x)
+    {
+        D3DMATRIX m{};
+        m._11 = m._22 = m._33 = m._44 = 1.0f;
+        m._41 = x;
+        return m;
+    }
+
+    bool KnownRT(IDirect3DSurface9* rt, IDirect3DSurface9* a,
+                 IDirect3DSurface9* b, IDirect3DSurface9* c)
+    {
+        return !rt || rt == a || rt == b || rt == c ||
+               rt == StereoRenderer::Get().EyeSurface(0) ||
+               rt == StereoRenderer::Get().EyeSurface(1);
+    }
+
+    void CheckInvariants(FakeDevice& dev, IDirect3DSurface9* bb,
+                         IDirect3DSurface9* off, IDirect3DSurface9* main2)
+    {
+        StereoRenderer& sr = StereoRenderer::Get();
+        if (sr.IsActive())
+        {
+            CHECK(sr.EyeSurface(0) != nullptr);
+            CHECK(sr.EyeSurface(1) != nullptr);
+            CHECK(sr.EyeWidth() != 0 && sr.EyeHeight() != 0);
+        }
+        CHECK(KnownRT(dev.rt[0], bb, off, main2));
+        CHECK(dev.presentCount >= 0);
+    }
+}
+
+int main()
+{
+    Config& cfg = Config::Get();
+    cfg.enableStereo = true;
+    cfg.outputMode = 0;
+    cfg.dumpFrames = 0;
+    cfg.logLevel = 0;
+    cfg.sbsMonoUI = true;
+    cfg.uiMaxTriangles = 64;
+    cfg.ipd = 0.064f;
+    cfg.worldScale = 1.0f;
+    cfg.offscreenPasses = false;
+    cfg.sharedSurface = false;
+    cfg.viewSource = 0;
+    cfg.headTracking = false;
+
+    FakeDevice dev(320, 240);
+    FakeSurface bb(320, 240), off(64, 64), main2(320, 240);
+    StereoRenderer::Get().OnDeviceCreated(&dev, &dev.pp);
+    DeviceHooks::Get().OnDeviceCreated(&dev, &dev.pp);
+    hkSetRenderTarget(&dev, 0, &bb);
+    hkBeginScene(&dev);
+
+    Rng rng;
+    for (int i = 0; i < 800; ++i)
+    {
+        const uint32_t op = rng.Below(14);
+
+        // Sparse deterministic HRESULT failures.
+        dev.drawResult = (rng.Below(41) == 0) ? E_FAIL : S_OK;
+        dev.presentResult = (rng.Below(53) == 0) ? E_FAIL : S_OK;
+        dev.beginSceneResult = (rng.Below(59) == 0) ? E_FAIL : S_OK;
+        dev.endSceneResult = (rng.Below(61) == 0) ? E_FAIL : S_OK;
+        dev.clearResult = (rng.Below(47) == 0) ? E_FAIL : S_OK;
+
+        switch (op)
+        {
+        case 0:
+            hkSetRenderTarget(&dev, 0, &bb);
+            break;
+        case 1:
+            hkSetRenderTarget(&dev, 0, &off);
+            break;
+        case 2:
+            hkSetRenderTarget(&dev, 0, &main2);
+            break;
+        case 3:
+        {
+            D3DMATRIX m = Matrix((float)(rng.Below(21) - 10) * 0.1f);
+            hkSetTransform(&dev, D3DTS_VIEW, &m);
+            break;
+        }
+        case 4:
+        {
+            D3DMATRIX m = Matrix(0.25f);
+            Config::Get().viewSource = 1;
+            hkSetVertexShaderConstantF(&dev, 0, reinterpret_cast<const float*>(&m), 4);
+            Config::Get().viewSource = 0;
+            break;
+        }
+        case 5:
+        {
+            D3DVIEWPORT9 vp{0, 0, 160 + rng.Below(161), 120 + rng.Below(121), 0.0f, 1.0f};
+            hkSetViewport(&dev, &vp);
+            break;
+        }
+        case 6:
+        {
+            RECT r{0, 0, (LONG)(1 + rng.Below(320)), (LONG)(1 + rng.Below(240))};
+            hkSetRenderState(&dev, D3DRS_SCISSORTESTENABLE, rng.Below(2));
+            hkSetScissorRect(&dev, &r);
+            break;
+        }
+        case 7:
+            hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, rng.Below(201));
+            break;
+        case 8:
+            hkDrawIndexedPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 0, 4, 0, rng.Below(201));
+            break;
+        case 9:
+            hkDrawPrimitiveUP(&dev, D3DPT_TRIANGLELIST, rng.Below(201), nullptr, 0);
+            break;
+        case 10:
+            hkClear(&dev, 0, nullptr, D3DCLEAR_TARGET | D3DCLEAR_ZBUFFER, 0, 1.0f, 0);
+            break;
+        case 11:
+            hkPresent(&dev, nullptr, nullptr, nullptr, nullptr);
+            break;
+        case 12:
+            hkEndScene(&dev);
+            hkBeginScene(&dev);
+            break;
+        case 13:
+        {
+            D3DPRESENT_PARAMETERS pp = dev.pp;
+            static const UINT sizes[4][2] = {{320,240},{640,480},{800,600},{1600,900}};
+            const uint32_t pick = rng.Below(4);
+            pp.BackBufferWidth = sizes[pick][0];
+            pp.BackBufferHeight = sizes[pick][1];
+            dev.resetResult = (rng.Below(5) == 0) ? E_FAIL : S_OK;
+            if (dev.resetResult == S_OK && rng.Below(3) == 0)
+                dev.failCreateRenderTargetCalls = 1;
+            if (dev.resetResult == S_OK && rng.Below(3) == 0)
+                dev.failCreateDepthStencilCalls = 1;
+            hkReset(&dev, &pp);
+            dev.resetResult = S_OK;
+            dev.drawResult = S_OK;
+            hkSetRenderTarget(&dev, 0, &bb); // fake bb object remains valid across Reset
+            hkBeginScene(&dev);
+            break;
+        }
+        }
+
+        Config::Get().offscreenPasses = (rng.Below(5) == 0);
+        CheckInvariants(dev, &bb, &off, &main2);
+    }
+
+    // Final cleanup must be safe after any mixed success/failure stream.
+    hkPresent(&dev, nullptr, nullptr, nullptr, nullptr);
+    StereoRenderer::Get().Shutdown();
+    DeviceHooks::Get().Shutdown();
+    CHECK(StereoRenderer::Get().EyeSurface(0) == nullptr);
+    CHECK(!StereoRenderer::Get().IsActive());
+
+    printf("fuzz: %d checks, %d failures (800 iterations)\n", g_checks, g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/tests/test_integration.cpp b/tests/test_integration.cpp
new file mode 100644
index 0000000..cede398
--- /dev/null
+++ b/tests/test_integration.cpp
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Headless integration tests: real DeviceHooks + StereoRenderer + Config +
+// Logger compiled against the winshim, driven through a recording FakeDevice.
+// Run from tests/: ./run_integration
+//
+// Scenarios assert the duplication gate end-to-end: which device calls
+// happen, how many times, and with what render targets.
+
+#include "windows.h"
+#include "d3d9.h"
+#include "fake_device.h"
+#include "Config.h"
+#include "Logger.h"
+#include "StereoRenderer.h"
+#include "DeviceHooks.h"
+#include "MathUtil.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sys/stat.h>
+
+static int g_failures = 0, g_checks = 0;
+#define CHECK(cond) do { ++g_checks; if (!(cond)) { \
+    ++g_failures; printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); } } while (0)
+
+static void WriteIni(const char* text)
+{
+    mkdir("/tmp/wbvr_test", 0755);
+    FILE* f = fopen("/tmp/wbvr_test/WarbandVR.ini", "w");
+    fputs(text, f);
+    fclose(f);
+    setenv("WBVR_TEST_DIR", "/tmp/wbvr_test", 1);
+}
+
+static void WriteTestIni()
+{
+    WriteIni("[Stereo]\nEnableStereo=1\nSBSMonoUI=1\nUIMaxTriangles=64\nIPD=0.064\n"
+             "[Comfort]\nWorldScalePreset=realistic\nVignette=0\n"
+             "[Output]\nOutputMode=0\n[Debug]\nLogLevel=0\nDumpFrames=0\n");
+}
+
+static D3DMATRIX IdentityM()
+{
+    D3DMATRIX m{}; m._11 = m._22 = m._33 = m._44 = 1.0f; return m;
+}
+
+int main()
+{
+    // The logger writes under WBVR_TEST_DIR (winshim default below); create
+    // it before the first Init or every log call silently no-ops on a clean
+    // machine (regression: crash-log checks failed only on fresh sandboxes).
+    mkdir("/tmp/wbvr_test", 0755);
+    Log::Init(0);
+
+    // Comfort preset parsing: preset supplies worldScale when no explicit
+    // numeric [Stereo] WorldScale key exists; the expert numeric key wins.
+    WriteIni("[Stereo]\nEnableStereo=1\n[Comfort]\nWorldScalePreset=large\n"
+             "Vignette=1\nVignetteStrength=2.0\n[Debug]\nLogLevel=0\n");
+    Config::Get().Load();
+    CHECK(Config::Get().worldScale == 1.15f);
+    CHECK(Config::Get().comfortVignette);
+    CHECK(Config::Get().vignetteStrength == 1.0f);
+    WriteIni("[Stereo]\nEnableStereo=1\nWorldScale=1.23\n"
+             "[Comfort]\nWorldScalePreset=large\nVignette=0\n[Debug]\nLogLevel=0\n");
+    Config::Get().Load();
+    CHECK(Config::Get().worldScale == 1.23f);
+    CHECK(!Config::Get().comfortVignette);
+
+    // Controller preset: [Preset.<name>] overrides only the keys it sets;
+    // base [Input] values remain for the rest. Empty preset = no override.
+    WriteIni("[Input]\nSwingThreshold=1.8\nSteerScale=40.0\nBlockHoldTime=0.15\n"
+             "ControllerPreset=quest\n"
+             "[Preset.Quest]\nSwingThreshold=2.5\n[Debug]\nLogLevel=0\n");
+    Config::Get().Load();
+    CHECK(Config::Get().swingThreshold == 2.5f);   // preset override
+    CHECK(Config::Get().steerScale == 40.0f);       // untouched by the preset
+    WriteIni("[Input]\nSwingThreshold=1.9\nControllerPreset=\n[Debug]\nLogLevel=0\n");
+    Config::Get().Load();
+    CHECK(Config::Get().swingThreshold == 1.9f);    // empty preset: base value
+
+    // --- crash handler logs module+RVA and never swallows -------------------
+    {
+        static int g_crashSite = 0;
+        EXCEPTION_RECORD rec{};
+        rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+        rec.ExceptionAddress = &g_crashSite;
+        CONTEXT ctx{};
+        EXCEPTION_POINTERS ep{ &rec, &ctx };
+        CHECK(Log::CrashLogForTest(&ep) == EXCEPTION_CONTINUE_SEARCH);
+        rec.ExceptionCode = 0x80000003; // breakpoint: deliberately not logged
+        CHECK(Log::CrashLogForTest(&ep) == EXCEPTION_CONTINUE_SEARCH);
+        FILE* f = fopen("/tmp/wbvr_test/WarbandVR_log.txt", "r");
+        char buf[4096] = {};
+        if (f) { (void)fread(buf, 1, sizeof(buf) - 1, f); fclose(f); }
+        CHECK(strstr(buf, "CRASH code=0xC0000005 at d3d9.dll+") != nullptr);
+        CHECK(strstr(buf, "80000003") == nullptr);
+    }
+
+    // --- previous log survives a relaunch (prev-log rotation) ---------------
+    Log::Shutdown();
+    Log::Init(0);
+    {
+        FILE* f = fopen("/tmp/wbvr_test/WarbandVR_log.prev.txt", "r");
+        CHECK(f != nullptr); // the pre-relaunch log (with the CRASH line)
+        if (f) fclose(f);
+    }
+
+    WriteTestIni();
+    Config::Get().Load();
+    CHECK(Config::Get().enableStereo);
+    CHECK(Config::Get().uiMaxTriangles == 64);
+
+    // --- device creation builds per-eye resources -------------------------
+    FakeDevice dev(1600, 900);
+    StereoRenderer::Get().OnDeviceCreated(&dev, &dev.pp);
+    DeviceHooks::Get().OnDeviceCreated(&dev, &dev.pp);
+    CHECK(!StereoRenderer::Get().IsActive()); // not before first BeginScene
+    CHECK(StereoRenderer::Get().EyeSurface(0) != nullptr);
+    CHECK(StereoRenderer::Get().EyeSurface(1) != nullptr);
+    CHECK(StereoRenderer::Get().EyeSurface(0) != StereoRenderer::Get().EyeSurface(1));
+    CHECK(StereoRenderer::Get().EyeWidth() == 1600 && StereoRenderer::Get().EyeHeight() == 900);
+
+    IDirect3DSurface9* bb = nullptr;
+    dev.GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &bb);
+
+    // Stereo arms at BeginScene (per-frame lifecycle), not at creation.
+    hkSetRenderTarget(&dev, 0, bb);
+    hkBeginScene(&dev);
+    CHECK(StereoRenderer::Get().IsActive());
+
+    // --- world draw on the main RT duplicates per eye ---------------------
+    Fake::Clear();
+    hkSetRenderTarget(&dev, 0, bb);
+    CHECK(StereoRenderer::Get().CurrentRTIsMain());
+    D3DMATRIX view = IdentityM();
+    hkSetTransform(&dev, D3DTS_VIEW, &view);
+
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100); // world: 100 tris > 64
+    CHECK(Fake::Count("DrawPrimitive") == 2);          // once per eye
+    CHECK(Fake::Count("SetRenderTarget 0") >= 2);      // eye targets + restore
+    // device ends back on the game's RT
+    IDirect3DSurface9* cur = nullptr;
+    dev.GetRenderTarget(0, &cur);
+    CHECK(cur == bb);
+
+    // --- tiny UI batch goes flat to both halves, no eye shift -------------
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 2);   // 2-triangle composite quad
+    CHECK(Fake::Count("DrawPrimitive") == 2);
+    // flat: no eye-shifted transform (eye shift would show as _41 != 0)
+    CHECK(Fake::CountContaining("SetTransform", "_41=0.0000") == Fake::Count("SetTransform"));
+
+    // --- above-threshold batch duplicates ---------------------------------
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 65);
+    CHECK(Fake::Count("DrawPrimitive") == 2);
+    CHECK(Fake::Count("SetTransform") > 0);            // eye matrices applied
+    CHECK(Fake::CountContaining("SetTransform", "_41=-0.0320") > 0 ||
+          Fake::CountContaining("SetTransform", "_41=0.0320") > 0); // eye shift present
+
+    // --- steep-pitch view is NOT misclassified as flat UI -------------------
+    // cos(pitch) shrinks _33 below the z cutoff; the orthonormal-row guard
+    // must keep it stereo (regression: old z-only rule flattened this).
+    D3DMATRIX steep = MatToD3D(MatPure::RotationYPR(0.0f, 80.0f * 3.14159265f / 180.0f, 0.0f));
+    hkSetTransform(&dev, D3DTS_VIEW, &steep);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("DrawPrimitive") == 2);
+    CHECK(Fake::CountContaining("SetTransform", "_41=0.0320") > 0 ||
+          Fake::CountContaining("SetTransform", "_41=-0.0320") > 0); // still shifted
+    hkSetTransform(&dev, D3DTS_VIEW, &view); // back to the plain view
+
+    // --- encounter-dialog layout: identity view + ORTHO projection ---------
+    // A large batch (so the tiny-batch flat path does not apply) must NOT be
+    // eye-shifted: under an ortho projection a view translation is a pure
+    // screen-space offset and moves text relative to flat backgrounds.
+    D3DMATRIX ortho = {};
+    ortho._11 = 2.0f / 1024.0f; ortho._22 = -2.0f / 768.0f;
+    ortho._33 = 0.001f; ortho._41 = -1.0f; ortho._42 = 1.0f; ortho._44 = 1.0f;
+    hkSetTransform(&dev, D3DTS_PROJECTION, &ortho);
+    D3DMATRIX identity = IdentityM();
+    hkSetTransform(&dev, D3DTS_VIEW, &identity);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("DrawPrimitive") == 2);
+    CHECK(Fake::CountContaining("SetTransform", "_41=0.0000") == Fake::Count("SetTransform"));
+
+    // ... and the same identity view under a PERSPECTIVE projection shifts.
+    D3DMATRIX persp = {};
+    persp._11 = 1.0f; persp._22 = 1.0f; persp._33 = 2.0f;
+    persp._34 = 1.0f; persp._43 = -0.2f; persp._44 = 0.0f;
+    hkSetTransform(&dev, D3DTS_PROJECTION, &persp);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::CountContaining("SetTransform", "_41=0.0320") > 0 ||
+          Fake::CountContaining("SetTransform", "_41=-0.0320") > 0);
+
+    // --- dirty tracking: only the first eye of the first pair applies ------
+    StereoRenderer::Get().OnReset(&dev, nullptr); // clear dirty flags
+    hkSetRenderTarget(&dev, 0, bb);
+    hkBeginScene(&dev);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("SetViewport") == 1);
+
+    // --- game's own offscreen RT passes through untouched -----------------
+    Fake::Clear();
+    FakeSurface shadowMap(256, 256);
+    hkSetRenderTarget(&dev, 0, &shadowMap);
+    CHECK(!StereoRenderer::Get().CurrentRTIsMain());
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 50);
+    CHECK(Fake::Count("DrawPrimitive") == 1);          // mono passthrough
+    hkSetRenderTarget(&dev, 0, bb);
+
+    // --- draws sampling a diverted main-sized surface are skipped ---------
+    // The backbuffer-sized "world texture" surface was RT0 while stereo was
+    // active, so it is on the diverted list (its content lives in the eyes).
+    Fake::Clear();
+    FakeSurface worldTex(1600, 900);
+    hkSetRenderTarget(&dev, 0, &worldTex);             // becomes diverted
+    hkSetRenderTarget(&dev, 0, bb);
+    class FakeSurfTex : public IDirect3DTexture9 { // minimal texture whose
+    public:                                            // level-0 surface is the
+        IDirect3DSurface9* s;                          // diverted one
+        explicit FakeSurfTex(IDirect3DSurface9* surf) : s(surf) {}
+        HRESULT __stdcall QueryInterface(REFIID, void** pp) override { *pp = this; return S_OK; }
+        ULONG __stdcall AddRef() override { return 1; }
+        ULONG __stdcall Release() override { return 1; }
+        HRESULT __stdcall GetDevice(IDirect3DDevice9**) override { return S_OK; }
+        HRESULT __stdcall SetPrivateData(REFGUID, const void*, DWORD, DWORD) override { return S_OK; }
+        HRESULT __stdcall GetPrivateData(REFGUID, void*, DWORD*) override { return S_OK; }
+        HRESULT __stdcall FreePrivateData(REFGUID) override { return S_OK; }
+        DWORD __stdcall SetPriority(DWORD) override { return 0; }
+        DWORD __stdcall GetPriority() override { return 0; }
+        void __stdcall PreLoad() override {}
+        D3DRESOURCETYPE __stdcall GetType() override { return D3DRTYPE_TEXTURE; }
+        DWORD __stdcall SetLOD(DWORD) override { return 0; }
+        DWORD __stdcall GetLOD() override { return 0; }
+        DWORD __stdcall GetLevelCount() override { return 1; }
+        HRESULT __stdcall SetAutoGenFilterType(D3DTEXTUREFILTERTYPE) override { return S_OK; }
+        D3DTEXTUREFILTERTYPE __stdcall GetAutoGenFilterType() override { return D3DTEXF_NONE; }
+        void __stdcall GenerateMipSubLevels() override {}
+        HRESULT __stdcall GetLevelDesc(UINT, D3DSURFACE_DESC* p) override { return s->GetDesc(p); }
+        HRESULT __stdcall GetSurfaceLevel(UINT, IDirect3DSurface9** pp) override { *pp = s; return S_OK; }
+        HRESULT __stdcall LockRect(UINT, D3DLOCKED_RECT*, const RECT*, DWORD) override { return S_OK; }
+        HRESULT __stdcall UnlockRect(UINT) override { return S_OK; }
+        HRESULT __stdcall AddDirtyRect(const RECT*) override { return S_OK; }
+    } wt(&worldTex);
+    Fake::Clear();
+    hkSetTexture(&dev, 0, &wt);
+    CHECK(StereoRenderer::Get().DivertedTextureBound());
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 2);
+    CHECK(Fake::Count("DrawPrimitive") == 0);          // skipped entirely
+    hkSetTexture(&dev, 0, nullptr);                    // unbind
+    CHECK(!StereoRenderer::Get().DivertedTextureBound());
+
+    // --- internal guard passes straight through ----------------------------
+    Fake::Clear();
+    DeviceHooks::Get().m_internal = true;
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("DrawPrimitive") == 1);          // no duplication
+    DeviceHooks::Get().m_internal = false;
+
+    // --- comfort vignette draws the generated radial overlay into both eyes --
+    Config::Get().comfortVignette = true;
+    Config::Get().vignetteStrength = 0.75f;
+    Fake::Clear();
+    hkEndScene(&dev);
+    CHECK(Fake::Count("CreateTexture 64x64") == 1);
+    CHECK(Fake::Count("DrawPrimitiveUP") == 2);
+    CHECK(Fake::Count("SetRenderTarget 0") >= 3); // eye0, eye1, restore
+    CHECK(dev.renderStates[D3DRS_ALPHABLENDENABLE] == 0);
+    CHECK(dev.renderStates[D3DRS_ZENABLE] == 0);
+    CHECK(dev.fvf == 0);
+    CHECK(dev.textures[0] == nullptr);
+    Config::Get().comfortVignette = false;
+
+    // --- Present composites both eyes to the backbuffer ---------------------
+    Fake::Clear();
+    hkPresent(&dev, nullptr, nullptr, nullptr, nullptr);
+    CHECK(Fake::Count("StretchRect") == 2);
+    // Aspect-correct composite: 1600x900 eyes fit into 800x900 panels as
+    // 800x450 images, centered vertically (no UI distortion).
+    CHECK(Fake::CountContaining("StretchRect", "dst=0,225,800,675") > 0);
+    CHECK(Fake::CountContaining("StretchRect", "dst=800,225,1600,675") > 0);
+    CHECK(Fake::Count("Present") == 1);
+    CHECK(!StereoRenderer::Get().IsActive());
+
+    // Rearm for the next frame.
+    hkSetRenderTarget(&dev, 0, bb);
+    hkBeginScene(&dev);
+    CHECK(StereoRenderer::Get().IsActive());
+
+    // --- game scissor state is applied per eye and restored -----------------
+    RECT sr = { 10, 20, 300, 200 };
+    hkSetRenderState(&dev, D3DRS_SCISSORTESTENABLE, TRUE);
+    hkSetScissorRect(&dev, &sr);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("SetScissorRect") == 2); // one apply + one restore
+    CHECK(dev.hasScissor);
+    CHECK(dev.scissor.left == 10 && dev.scissor.right == 300);
+
+    // --- ViewSource=1: eye shift uses VS register readback and restores it --
+    Config::Get().viewSource = 1;
+    Config::Get().vsViewRegister = 0;
+    D3DMATRIX shaderView = IdentityM();
+    shaderView._41 = 0.5f;
+    hkSetVertexShaderConstantF(&dev, 0, reinterpret_cast<const float*>(&shaderView), 4);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("DrawPrimitive") == 2);
+    CHECK(Fake::Count("SetVSCF c0 x4") == 3); // eye0, eye1, restore
+    CHECK(Fake::CountContaining("SetVSCF", "_41=0.5320") > 0 ||
+          Fake::CountContaining("SetVSCF", "_41=0.4680") > 0);
+    CHECK(dev.vsConstants[12] == shaderView._41); // game's register restored
+
+    // --- ViewSource=1 with an implausible register: fail safe to mono -------
+    // A wrong VSViewRegister guess yields garbage; the pair must render
+    // unshifted (no upload, no restore) rather than stereo-shifting garbage.
+    D3DMATRIX garbage = {};
+    hkSetVertexShaderConstantF(&dev, 0, reinterpret_cast<const float*>(&garbage), 4);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("DrawPrimitive") == 2);   // both eyes still draw
+    CHECK(Fake::Count("SetVSCF c0 x4") == 0);   // no shifted upload, no restore
+
+    D3DMATRIX hugeMat = IdentityM();
+    hugeMat._11 = 1.0e30f; // beyond any sane world extent
+    hkSetVertexShaderConstantF(&dev, 0, reinterpret_cast<const float*>(&hugeMat), 4);
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("SetVSCF c0 x4") == 0);
+    Config::Get().viewSource = 0;
+
+    // --- opt-in offscreen pass: per-eye shadow targets and clears -----------
+    Config::Get().offscreenPasses = true;
+    FakeSurface shadow256(256, 256);
+    Fake::Clear();
+    hkSetRenderTarget(&dev, 0, &shadow256);
+    CHECK(StereoRenderer::Get().ShadowActive());
+    CHECK(Fake::Count("CreateTexture 256x256") == 2);
+    hkClear(&dev, 0, nullptr, D3DCLEAR_TARGET, 0, 1.0f, 0);
+    CHECK(Fake::Count("Clear") == 2);
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 65);
+    CHECK(Fake::Count("DrawPrimitive") == 2);
+    hkSetRenderTarget(&dev, 0, bb);
+    CHECK(!StereoRenderer::Get().ShadowActive());
+
+    // --- shadow texture binds must NOT leak into main-scene draws ---------
+    // Regression: an offscreen "cow" texture would otherwise be substituted
+    // into later main-scene draws (e.g. the ocean).
+    IDirect3DTexture9* cowTex = nullptr;
+    dev.CreateTexture(256, 256, 1, D3DUSAGE_RENDERTARGET, D3DFMT_X8R8G8B8,
+                      D3DPOOL_DEFAULT, &cowTex, nullptr);
+    IDirect3DSurface9* cowSurf = nullptr;
+    cowTex->GetSurfaceLevel(0, &cowSurf);
+    hkSetRenderTarget(&dev, 0, cowSurf);       // activate a shadow pass
+    hkSetTexture(&dev, 0, cowTex);             // stage 0 samples that surface
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 65);
+    CHECK(dev.textures[0] == cowTex);          // game's texture restored
+    hkSetRenderTarget(&dev, 0, bb);             // pass ends
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 65);
+    CHECK(Fake::Count("SetTexture 0") == 0);    // no substitution on main scene
+    CHECK(dev.textures[0] == cowTex);
+    Config::Get().offscreenPasses = false;
+
+    // --- Reset releases DEFAULT-pool eyes, then rebuilds at the new size ----
+    D3DPRESENT_PARAMETERS pp2 = dev.pp;
+    pp2.BackBufferWidth = 800; pp2.BackBufferHeight = 600;
+    Fake::Clear();
+    CHECK(SUCCEEDED(hkReset(&dev, &pp2)));
+    CHECK(StereoRenderer::Get().EyeSurface(0) == nullptr);
+    IDirect3DSurface9* bb2 = nullptr;
+    dev.GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &bb2);
+    hkSetRenderTarget(&dev, 0, bb2);
+    hkBeginScene(&dev);
+    CHECK(StereoRenderer::Get().IsActive());
+    CHECK(StereoRenderer::Get().EyeWidth() == 800);
+    CHECK(StereoRenderer::Get().EyeHeight() == 600);
+    CHECK(Fake::Count("CreateRenderTarget 800x600") == 2);
+
+    // --- SharedSurface failure falls back to plain eye targets --------------
+    Config::Get().sharedSurface = true;
+    StereoRenderer::Get().Shutdown();
+    FakeDevice exDev(1024, 768);
+    exDev.failCreateTextureCalls = 1;
+    Fake::Clear();
+    StereoRenderer::Get().OnDeviceCreated(&exDev, &exDev.pp);
+    CHECK(StereoRenderer::Get().EyeSurface(0) != nullptr);
+    CHECK(StereoRenderer::Get().EyeSharedHandle(0) == nullptr);
+    CHECK(Fake::Count("CreateTexture 1024x768") == 1);
+    CHECK(Fake::Count("CreateRenderTarget 1024x768") == 2);
+    Config::Get().sharedSurface = false;
+
+    // --- eye creation failure is contained and retried next frame -----------
+    StereoRenderer::Get().Shutdown();
+    FakeDevice failDev(640, 480);
+    failDev.failCreateRenderTargetCalls = 1;
+    StereoRenderer::Get().OnDeviceCreated(&failDev, &failDev.pp);
+    CHECK(StereoRenderer::Get().EyeSurface(0) == nullptr);
+    hkBeginScene(&failDev);
+    CHECK(StereoRenderer::Get().EyeSurface(0) != nullptr);
+    CHECK(StereoRenderer::Get().EyeWidth() == 640);
+
+    // --- failed Reset does not crash; resources stay released ---------------
+    StereoRenderer::Get().OnDeviceCreated(&dev, &dev.pp);
+    dev.resetResult = E_FAIL;
+    D3DPRESENT_PARAMETERS pp3 = dev.pp;
+    CHECK(hkReset(&dev, &pp3) == E_FAIL);
+    CHECK(StereoRenderer::Get().EyeSurface(0) == nullptr);
+    dev.resetResult = S_OK;
+
+    // --- EnableStereo=0: stock passthrough ---------------------------------
+    Config::Get().enableStereo = false;
+    StereoRenderer::Get().Shutdown();
+    StereoRenderer::Get().OnDeviceCreated(&dev, &dev.pp);
+    CHECK(!StereoRenderer::Get().IsActive());
+    Fake::Clear();
+    hkDrawPrimitive(&dev, D3DPT_TRIANGLELIST, 0, 100);
+    CHECK(Fake::Count("DrawPrimitive") == 1);
+    CHECK(Fake::Count("SetTransform") == 0);
+
+    // --- shutdown path runs clean ------------------------------------------
+    Config::Get().enableStereo = true;
+    StereoRenderer::Get().Shutdown();
+    DeviceHooks::Get().Shutdown();
+    Log::Shutdown();
+
+    printf("integration: %d checks, %d failures\n", g_checks, g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/tests/test_main.cpp b/tests/test_main.cpp
new file mode 100644
index 0000000..0d53a42
--- /dev/null
+++ b/tests/test_main.cpp
@@ -0,0 +1,539 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// WarbandVR headless unit tests - pure logic only (no Windows/D3D9/XR).
+// Build:  g++ -std=c++17 -Wall -Wextra -I../src test_main.cpp -o run_tests
+// Run:    ./run_tests   (exit 0 = all pass)
+//
+// Math is checked against hand-computed values, not snapshots.
+
+#include "Mat4.h"
+#include "DupGate.h"
+#include "MeleeCore.h"
+#include "GestureZones.h"
+#include "ParseUtil.h"
+#include "OneEuroFilter.h"
+#include "Comfort.h"
+#include "MouseMap.h"
+
+#include <cstdio>
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+static int g_failures = 0;
+static int g_checks   = 0;
+
+#define CHECK(cond) do { ++g_checks; if (!(cond)) { \
+    ++g_failures; \
+    printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); } } while (0)
+
+static bool Near(float a, float b, float eps = 1e-4f) { return std::fabs(a - b) < eps; }
+
+// ---------------------------------------------------------------------------
+// Eye math (MatPure)
+// ---------------------------------------------------------------------------
+
+// Standard D3D row-major perspective projection, n=0.1 f=100 fov~45 aspect=1.
+static Mat4 TestProj()
+{
+    Mat4 p = {};
+    const float n = 0.1f, f = 100.0f;
+    p._11 = 2.41421f; p._22 = 2.41421f;
+    p._33 = f / (f - n);   // 1.001001...
+    p._34 = 1.0f;
+    p._43 = -n * p._33;    // -0.100100...
+    return p;
+}
+
+static void TestEyeView()
+{
+    Mat4 id = MatPure::Identity();
+    // view_eye = T(+/-halfSep) * view_head; left eye (0) shifts +halfSep in x.
+    Mat4 L = MatPure::EyeView(id, 0.032f, 0);
+    Mat4 R = MatPure::EyeView(id, 0.032f, 1);
+    CHECK(Near(L._41, +0.032f) && Near(L._42, 0.0f) && Near(L._43, 0.0f));
+    CHECK(Near(R._41, -0.032f));
+    // halfSep=0 degenerate: identity in, identity out
+    Mat4 Z = MatPure::EyeView(id, 0.0f, 0);
+    CHECK(memcmp(&Z, &id, sizeof(Mat4)) == 0);
+    // Composes with a translated head view: T(s) * T(t) = T(s + t)
+    Mat4 hv = MatPure::Translation(1.0f, 2.0f, 3.0f);
+    Mat4 e = MatPure::EyeView(hv, 0.032f, 0);
+    CHECK(Near(e._41, 0.032f + 1.0f) && Near(e._42, 2.0f) && Near(e._43, 3.0f));
+}
+
+static void TestIsPlausibleTransform()
+{
+    // Valid transforms must pass: identity view, perspective-flavoured
+    // viewproj, and a small-scale orthographic UI matrix.
+    CHECK(MatPure::IsPlausibleTransform(MatPure::Identity()));
+    Mat4 vp = MatPure::Multiply(MatPure::Translation(3.0f, -2.0f, 5000.0f), TestProj());
+    CHECK(MatPure::IsPlausibleTransform(vp));
+    Mat4 ui = {};
+    ui._11 = 2.0f / 1024.0f; ui._22 = -2.0f / 768.0f; ui._33 = 0.001f;
+    ui._41 = -1.0f; ui._42 = 1.0f; ui._44 = 1.0f;
+    CHECK(MatPure::IsPlausibleTransform(ui));
+
+    // Garbage from a wrong register guess must fail.
+    Mat4 zero = {};
+    CHECK(!MatPure::IsPlausibleTransform(zero));           // all-zero register
+    Mat4 nan = MatPure::Identity();
+    nan._11 = std::numeric_limits<float>::quiet_NaN();
+    CHECK(!MatPure::IsPlausibleTransform(nan));
+    Mat4 inf = MatPure::Identity();
+    inf._42 = std::numeric_limits<float>::infinity();
+    CHECK(!MatPure::IsPlausibleTransform(inf));
+    Mat4 huge = MatPure::Identity();
+    huge._11 = 1.0e30f;
+    CHECK(!MatPure::IsPlausibleTransform(huge));           // absurd magnitude
+    Mat4 tiny = {};
+    tiny._11 = 1.0e-9f;                                    // below noise floor
+    CHECK(!MatPure::IsPlausibleTransform(tiny));
+}
+
+static void TestIsFlatOrtho()
+{
+    const float zMax = 0.5f, wEps = 0.01f, rnMax = 0.5f;
+    // Ortho UI matrix: tiny z-scale, w == 1, tiny row norms.
+    Mat4 ui = {};
+    ui._11 = 2.0f / 1024.0f; ui._22 = -2.0f / 768.0f; ui._33 = 0.001f;
+    ui._41 = -1.0f; ui._42 = 1.0f; ui._44 = 1.0f;
+    CHECK(MatPure::IsFlatOrtho(ui, zMax, wEps, rnMax));
+    // Identity (z-scale 1) is a 3D view, not UI.
+    CHECK(!MatPure::IsFlatOrtho(MatPure::Identity(), zMax, wEps, rnMax));
+    // viewproj products have w-row != affine.
+    Mat4 vp = MatPure::Multiply(MatPure::Translation(1.0f, 2.0f, 3.0f), TestProj());
+    CHECK(!MatPure::IsFlatOrtho(vp, zMax, wEps, rnMax));
+    // Thresholds are parameters: a borderline z-scale flips with the cutoff.
+    // (Row norms stay tiny so only the z cutoff decides.)
+    Mat4 border = {};
+    border._33 = 0.4f; border._44 = 1.0f;
+    CHECK(MatPure::IsFlatOrtho(border, 0.5f, wEps, rnMax));
+    CHECK(!MatPure::IsFlatOrtho(border, 0.3f, wEps, rnMax));
+    // Boundary: exactly at the cutoff is NOT flat (strict <).
+    Mat4 edge = {};
+    edge._33 = 0.5f; edge._44 = 1.0f;
+    CHECK(!MatPure::IsFlatOrtho(edge, 0.5f, wEps, rnMax));
+    // Steep-pitch 3D view: cos(80 deg) shrinks _33 below the z cutoff, but
+    // the orthonormal rows expose it as a rotation - it must stay stereo.
+    Mat4 steep = MatPure::RotationYPR(0.0f, 80.0f * 3.14159265f / 180.0f, 0.0f);
+    CHECK(steep._33 < 0.5f); // would trip the old z-only rule
+    CHECK(!MatPure::IsFlatOrtho(steep, zMax, wEps, rnMax));
+    // Row-norm parameter is honoured: raising it past 1 re-admits rotations.
+    CHECK(MatPure::IsFlatOrtho(steep, zMax, wEps, 2.0f));
+}
+
+// Deterministic property fuzz for the two classifiers: constructed-valid
+// matrices must be accepted, constructed-garbage must be rejected, and
+// rotations must never classify as flat UI regardless of orientation.
+static void TestClassifierFuzz()
+{
+    uint32_t s = 0xC1A551F1u;
+    auto next = [&]() { s ^= s << 13; s ^= s >> 17; s ^= s << 5; return s; };
+    auto unit = [&]() { return (next() % 2000000u) / 1000000.0f - 1.0f; }; // [-1,1)
+
+    for (int i = 0; i < 2000; ++i)
+    {
+        switch (next() % 4)
+        {
+        case 0: // random 3D view: rotation + translation
+        {
+            Mat4 v = MatPure::Multiply(
+                MatPure::RotationYPR(unit() * 3.14159f, unit() * 1.55f, unit() * 3.14159f),
+                MatPure::Translation(unit() * 500.0f, unit() * 50.0f, unit() * 500.0f));
+            CHECK(MatPure::IsPlausibleTransform(v));
+            CHECK(!MatPure::IsFlatOrtho(v, 0.5f, 0.01f, 0.5f));
+            break;
+        }
+        case 1: // pixel-space ortho UI at a random resolution
+        {
+            float w = 64.0f + (next() % 8129), h = 64.0f + (next() % 8129);
+            Mat4 ui = {};
+            ui._11 = 2.0f / w; ui._22 = (next() & 1 ? -2.0f : 2.0f) / h;
+            ui._33 = 1.0f / (3.0f + next() % 10000); // < zScaleMax by construction
+            ui._41 = -1.0f; ui._42 = 1.0f; ui._44 = 1.0f;
+            CHECK(MatPure::IsPlausibleTransform(ui));
+            CHECK(MatPure::IsFlatOrtho(ui, 0.5f, 0.01f, 0.5f));
+            break;
+        }
+        case 2: // garbage register contents
+        {
+            Mat4 g = {};
+            float* f = &g._11;
+            switch (next() % 4)
+            {
+            case 0: break; // all zero
+            case 1: f[next() % 16] = std::numeric_limits<float>::quiet_NaN(); break;
+            case 2: f[next() % 16] = std::numeric_limits<float>::infinity(); break;
+            case 3: f[next() % 16] = unit() * 1.0e30f; break;
+            }
+            CHECK(!MatPure::IsPlausibleTransform(g));
+            break;
+        }
+        case 3: // viewproj product: always plausible
+        {
+            Mat4 v = MatPure::Multiply(
+                MatPure::RotationYPR(unit() * 3.14159f, unit() * 1.55f, 0.0f),
+                MatPure::Translation(unit() * 100.0f, unit() * 10.0f, unit() * 100.0f));
+            Mat4 vp = MatPure::Multiply(v, TestProj());
+            CHECK(MatPure::IsPlausibleTransform(vp));
+            break;
+        }
+        }
+    }
+}
+
+static void TestIsPerspective()
+{
+    CHECK(MatPure::IsPerspective(TestProj()));
+    Mat4 ortho = MatPure::Identity();
+    ortho._33 = 0.001f; ortho._34 = 0.0f; // _44 = 1 from Identity
+    CHECK(!MatPure::IsPerspective(ortho));
+    CHECK(!MatPure::IsPerspective(MatPure::Identity()));
+}
+
+static void TestEyeProjection()
+{
+    Mat4 p = TestProj();
+    // nearPlane = -_43/_33 = 0.1 (hand-computed above)
+    const float expectShift = 0.032f * p._11 / 0.1f; // 0.77254...
+    // left eye: _31 = -halfSep * _11 / n ; right eye: +...
+    Mat4 L = MatPure::EyeProjection(p, 0.032f, 0);
+    Mat4 R = MatPure::EyeProjection(p, 0.032f, 1);
+    CHECK(Near(L._31, -expectShift, 1e-3f));
+    CHECK(Near(R._31, +expectShift, 1e-3f));
+    // all other elements unchanged
+    CHECK(Near(L._11, p._11) && Near(L._33, p._33) && Near(L._43, p._43));
+
+    // halfSep=0 degenerate: shift is 0, rest unchanged
+    Mat4 Z = MatPure::EyeProjection(p, 0.0f, 0);
+    CHECK(Near(Z._31, 0.0f) && Near(Z._11, p._11));
+
+    // _33 ~ 0 guard: unmodified
+    Mat4 bad = p; bad._33 = 0.0f;
+    Mat4 G = MatPure::EyeProjection(bad, 0.032f, 0);
+    CHECK(memcmp(&G, &bad, sizeof(Mat4)) == 0);
+
+    // orthographic (no _34 == 1): unmodified passthrough
+    Mat4 ortho = MatPure::Identity();
+    ortho._33 = 1.0f; ortho._34 = 0.0f; // _44 = 1 from Identity
+    Mat4 O = MatPure::EyeProjection(ortho, 0.032f, 0);
+    CHECK(memcmp(&O, &ortho, sizeof(Mat4)) == 0);
+
+    // negative near plane (malformed): unmodified
+    Mat4 neg = p; neg._43 = -neg._43; // flips extracted n to -0.1
+    Mat4 N = MatPure::EyeProjection(neg, 0.032f, 0);
+    CHECK(memcmp(&N, &neg, sizeof(Mat4)) == 0);
+}
+
+static void TestRotationTranspose()
+{
+    // R * R^T = I for pure rotations
+    Mat4 r  = MatPure::RotationYPR(0.3f, -0.2f, 0.1f);
+    Mat4 rt = MatPure::Transpose3x3(r);
+    Mat4 i  = MatPure::Multiply(r, rt);
+    Mat4 id = MatPure::Identity();
+    for (int k = 0; k < 16; ++k)
+        CHECK(Near((&i._11)[k], (&id._11)[k], 1e-5f));
+}
