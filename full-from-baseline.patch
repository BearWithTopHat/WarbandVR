+    // M5: actions are bound to the session; safe to ignore failure (input
+    // emulation is optional for M3 verification).
+    MotionInput::Init();
+
+    InitFilters();
+    LOG_INFO("OpenXRBridge: initialised (fastPath=%d)", g_fastPath ? 1 : 0);
+    return true;
