+    float v[3] = {};
+    CHECK(Parse::Vec3("1 , 2 , 3", v) && Near(v[0], 1) && Near(v[1], 2) && Near(v[2], 3));
+    CHECK(!Parse::Vec3("", v));
+    CHECK(!Parse::Vec3("1 , 2", v));
+}
