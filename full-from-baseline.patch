diff --git a/src/DupGate.h b/src/DupGate.h
new file mode 100644
index 0000000..373ba18
--- /dev/null
+++ b/src/DupGate.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// DupGate: pure duplication-gate decision, extracted from DeviceHooks'
+// DrawBothEyes so the policy is host-compilable and unit-tested headless.
+// No Windows/D3D9/XR headers.
+//
+// Callers guarantee stereo is on (Config.EnableStereo && renderer active)
+// before consulting this; the decision below is purely "given this draw,
+// what do we do with it".
+
+enum class DupDecision
+{
+    Skip,            // samples a diverted surface - drawing it would paint an
+                     // empty surface over the frame
+    MonoPassThrough, // game's own offscreen RT (shadow map etc.) - stock path
+    FlatBothHalves,  // tiny UI/composite batch: draw into both eyes with no
+                     // eye shift (SBSMonoUI)
+    StereoBothEyes,  // world geometry: full per-eye duplication with shift
+};
+
+inline DupDecision DecideDuplication(bool divertedTextureBound,
+                                     bool currentRTIsMain,
+                                     bool shadowPassActive,
+                                     bool sbsMonoUI,
+                                     int primCount,
+                                     int uiMaxTriangles)
+{
+    if (divertedTextureBound)
+        return DupDecision::Skip;
+    // An offscreen shadow pass is not main-sized, but when explicitly enabled
+    // we deliberately duplicate it into per-eye shadow targets.
+    if (!currentRTIsMain && !shadowPassActive)
+        return DupDecision::MonoPassThrough;
+    if (shadowPassActive)
+        return DupDecision::StereoBothEyes;
+    if (sbsMonoUI && primCount > 0 && primCount <= uiMaxTriangles)
+        return DupDecision::FlatBothHalves;
+    return DupDecision::StereoBothEyes;
+}
diff --git a/src/GestureZones.h b/src/GestureZones.h
new file mode 100644
index 0000000..f70ac51
--- /dev/null
+++ b/src/GestureZones.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// GestureZones: pure grab-zone classification (head-relative boxes in app
+// space), extracted from MotionInput.cpp so it is host-compilable and
+// unit-tested headless. No Windows/D3D9/XR headers.
+//
+// App-space axes: +X right, +Y up, -Z forward (so +dz means BEHIND the
+// head plane). Distances are hardcoded for an average body: tuning means
+// editing these constants and rebuilding (per-controller calibration is a
+// manual-checklist item, not yet an ini surface).
+
+#include <cmath>
+
+enum GrabZone { ZONE_NONE, ZONE_HIP_L, ZONE_HIP_R, ZONE_SHOULDER, ZONE_QUIVER };
+
+// hand: 0 = left, 1 = right. hp = hand position, head = head position (xyz).
+inline GrabZone ClassifyZone(int hand, const float* hp, const float* head)
+{
+    const int LEFT = 0, RIGHT = 1;
+    float dx = hp[0] - head[0];
+    float dy = hp[1] - head[1];
+    float dz = hp[2] - head[2];
+    // hip: below chest, slightly out to the hand's side, in front-ish
+    if (dy > -0.50f && dy < -0.18f && fabsf(dz) < 0.30f)
+    {
+        if (hand == LEFT  && dx < -0.08f && dx > -0.40f) return ZONE_HIP_L;
+        if (hand == RIGHT && dx >  0.08f && dx <  0.40f) return ZONE_HIP_R;
+    }
+    // over-shoulder: above shoulder line and behind the head plane
+    if (dy > -0.15f && dy < 0.25f && dz > 0.10f && dz < 0.45f)
+        return ZONE_SHOULDER;
+    // quiver: right-back, chest height (arrow grab for bows)
+    if (hand == RIGHT && dy > -0.35f && dy < -0.05f && dz > 0.08f && dz < 0.40f && dx > 0.05f)
+        return ZONE_QUIVER;
+    return ZONE_NONE;
+}
