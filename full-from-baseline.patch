+    XrQuaternionf QuatAvg(const XrQuaternionf& a, const XrQuaternionf& b)
+    {
+        XrQuaternionf bb = b;
+        float dot = a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w;
+        if (dot < 0.0f) { bb.x = -bb.x; bb.y = -bb.y; bb.z = -bb.z; bb.w = -bb.w; }
